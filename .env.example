# ---------------------------------------------------------------------------
# Configuration du bot de relance des adhésions HelloAsso
# Copiez ce fichier en `.env` et renseignez les valeurs.
# `.env` ne doit JAMAIS être versionné (il est dans .gitignore).
#   chmod 600 .env
# ---------------------------------------------------------------------------

# --- API HelloAsso ---------------------------------------------------------
# Espace association > Intégrations > API : créez un client et récupérez
# le client_id et le client_secret. Le client doit avoir le rôle
# OrganizationAdmin et le privilège AccessTransactions.
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=
# Le slug figure dans l'URL de votre page : helloasso.com/associations/<slug>
HELLOASSO_ORGANIZATION_SLUG=pause-ia

# --- Fenêtres de relance ---------------------------------------------------
# Deux relances successives, à fenêtres disjointes :
#   · préavis           : échéance dans les N jours à venir
#   · jour d'expiration : échéance atteinte (ou dépassée depuis peu)
RELANCE_DAYS_BEFORE_EXPIRY=15
# 0 = le mail d'expiration part le jour J uniquement.
# Mettre 7 pour rattraper aussi les adhésions expirées depuis moins d'une semaine.
RELANCE_DAYS_AFTER_EXPIRY=0

# Durée de validité, en jours, pour les formulaires en année glissante
# (validityType = MovingYear chez HelloAsso). 365 = 12 mois glissants.
RELANCE_MEMBERSHIP_DURATION_DAYS=365

# Ancienneté maximale des adhésions analysées (garde-fou au premier lancement).
RELANCE_MAX_MEMBERSHIP_AGE_DAYS=800

# Limiter à certains formulaires d'adhésion (slugs séparés par des virgules).
# Vide = tous les formulaires d'adhésion de l'organisation.
RELANCE_FORM_SLUGS=

# --- Envoi des mails (SMTP) -------------------------------------------------
# SMTP de l'association, ou relais transactionnel (Brevo, Mailjet, Sendgrid...),
# qui exposent tous un point d'entrée SMTP.
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true      # STARTTLS (port 587)
SMTP_USE_SSL=false     # SMTPS direct (port 465) ; exclusif avec SMTP_USE_TLS

MAIL_FROM=adhesions@example.org
MAIL_FROM_NAME=Pause IA
MAIL_REPLY_TO=contact@example.org
# Copie cachée pour archiver les relances (optionnel).
MAIL_BCC=
MAIL_SUBJECT=Votre adhésion à $association arrive à échéance
MAIL_SUBJECT_EXPIRATION=Votre adhésion à $association expire aujourd'hui

# --- Contenu ----------------------------------------------------------------
ASSOCIATION_NAME=Pause IA
# Lien vers le formulaire d'adhésion HelloAsso.
RENEWAL_URL=https://www.helloasso.com/associations/pause-ia/adhesions/adhesion
TEMPLATE_TEXT=templates/relance.txt
TEMPLATE_HTML=templates/relance.html
# Templates de la seconde relance. Absents, ceux du préavis sont réutilisés.
TEMPLATE_TEXT_EXPIRATION=templates/relance-expiration.txt
TEMPLATE_HTML_EXPIRATION=templates/relance-expiration.html

# --- Exécution --------------------------------------------------------------
STATE_DB=data/relances.sqlite3
LOG_FILE=logs/relance.log
LOG_LEVEL=INFO
# true = simulation permanente ; laisser false en production.
DRY_RUN=false
# Garde-fou anti-spam : au-delà, l'exécution s'interrompt sans rien envoyer.
MAX_EMAILS_PER_RUN=100
